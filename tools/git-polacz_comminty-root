#!/usr/bin/env bash
set -euo pipefail

MSG="${1:-checkpoint}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "To nie jest repozytorium git."
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Masz niezacommitowane zmiany. Zrób commit albo stash przed squashem."
  exit 1
fi

# Jeśli jest tylko 1 commit, nic nie rób
COUNT="$(git rev-list --count HEAD)"
if (( COUNT <= 1 )); then
  echo "Repo ma tylko jeden commit — nic do squasha."
  git --no-pager log --oneline -n 3
  exit 0
fi

# Reset do root commit i zrób jeden nowy commit (najprostsza metoda)
ROOT="$(git rev-list --max-parents=0 HEAD)"
git reset --soft "${ROOT}"
git commit --amend -m "${MSG}"

echo "OK: cała historia spłaszczona do 1 commita."
git --no-pager log --oneline -n 5
